# --- Ollama ---
OLLAMA_URL=http://localhost:11434
# Must be a vision-capable model. Check: curl localhost:11434/api/tags
VISION_MODEL=gemma4:12b
OLLAMA_TIMEOUT=180

# --- Storage ---
# On Linux/homelab set this to /storage/fitness_tracker
# Layout underneath: front/, profile/, meals/, _pending/
STORAGE_DIR=./storage/fitness_tracker
DB_PATH=./storage/fitness_tracker/tracker.db

# --- App ---
# IANA timezone; decides where the "day" boundary falls for daily totals.
TZ=Europe/Berlin
# Longest edge (px) the meal image is downscaled to before inference.
VISION_MAX_EDGE=1024
HOST=0.0.0.0
PORT=8000
