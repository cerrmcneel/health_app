# ==============================================================================
# Self-Hosted Health Tracker — Environment Configuration
# ==============================================================================
# All settings have sane defaults. Copy this file to .env to customize:
#   cp .env.example .env
# ==============================================================================

# --- AI & Vision Model (OPTIONAL) ---
# Ollama is 100% optional! All meal logging, weight tracking, photo comparison,
# knowledge base, and equipment workout design work offline without any AI model.
#
# If you have Ollama with a vision-capable model (e.g. gemma4:12b, qwen2.5-vl:7b, llava),
# configure the URL below to unlock AI photo meal analysis and the AI workout coach:
#
# - If running native Python:           http://localhost:11434
# - If running in Docker (same host):   http://host.docker.internal:11434
# - If running on remote GPU on LAN:    http://192.168.1.50:11434
# - If running over Tailscale:          http://100.x.y.z:11434
OLLAMA_URL=http://localhost:11434
VISION_MODEL=gemma4:12b
OLLAMA_TIMEOUT=180

# --- Storage ---
# Stores the SQLite database and captured progress / meal photos.
# - For Docker: leave default or mount to a host directory in docker-compose.yml
# - For native Python: defaults to ./storage/fitness_tracker relative to project root
STORAGE_DIR=./storage/fitness_tracker
DB_PATH=./storage/fitness_tracker/tracker.db

# --- Application & Timezone ---
# IANA timezone (e.g. Europe/Madrid, America/New_York, UTC).
# Sets the midnight boundary for daily totals and weigh-ins.
TZ=Europe/Madrid

# Server bind settings (for native uvicorn execution)
HOST=0.0.0.0
PORT=8000

# Longest edge (px) for photo downscaling prior to storage/inference
VISION_MAX_EDGE=1024

# --- Optional TLS for Native Python (not needed when using Docker Nginx or Reverse Proxy) ---
# Browsers require HTTPS for phone camera access.
# Leave blank to serve plain HTTP, or run `python make_cert.py` to create self-signed certs.
SSL_CERTFILE=
SSL_KEYFILE=
